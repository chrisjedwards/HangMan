#!/bin/bash
# Cloud-init user-data for the Hangman EC2 instance (Amazon Linux 2023).
# Output goes to /var/log/cloud-init-output.log by default (not suppressed
# here) - check that file over SSH if the app doesn't come up.
#
# set -x logs every command to that same file, which is the point during a
# graded, short-lived deployment: if something breaks, we want to see
# exactly where without re-running anything.
set -euxo pipefail

dnf update -y
dnf install -y python3 python3-pip git nginx

# --- Clone the app (public repo, plain HTTPS, no credentials needed) ---
git clone https://github.com/chrisjedwards/HangMan.git /opt/hangman

# --- .env at the REPO ROOT, not backend/ - config.py's load_dotenv() finds
# it there even when gunicorn's working directory is backend/, exactly as
# verified in local testing. MAX_HINTS/MAX_LIVES/RATE_LIMIT/FLASK_DEBUG
# match .env.example's defaults; MOCK_AI is false here since the whole
# point of this deployment is to serve real Bedrock games. ---
cat > /opt/hangman/.env <<EOF
BEDROCK_REGION=${bedrock_region}
BEDROCK_MODEL_ID=${bedrock_model_id}
MOCK_AI=false
MAX_HINTS=2
MAX_LIVES=6
RATE_LIMIT=60 per minute
FLASK_DEBUG=0
EOF

# --- Python venv + dependencies, same as local setup ---
cd /opt/hangman/backend
python3 -m venv .venv
.venv/bin/pip install --upgrade pip
.venv/bin/pip install -r requirements.txt

# ec2-user owns the checkout so the systemd service below doesn't run as
# root; everything up to here ran as root (cloud-init's default).
chown -R ec2-user:ec2-user /opt/hangman

# --- systemd service: gunicorn, exactly one worker (game state is
# in-memory - see backend/config.py's design note), run from backend/ so
# the relative "app:create_app()" import and the repo-root .env lookup
# both resolve the same way they do locally. ---
cat > /etc/systemd/system/hangman.service <<'EOF'
[Unit]
Description=Hangman Flask app (gunicorn)
After=network.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/opt/hangman/backend
ExecStart=/opt/hangman/backend/.venv/bin/gunicorn --workers 1 --threads 4 -b 127.0.0.1:8000 "app:create_app()"
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable hangman
systemctl start hangman

# --- Nginx: reverse proxy "/" and "/api/" to gunicorn on 127.0.0.1:8000
# (gunicorn's default bind), same-origin like the local dev server serves
# both frontend and API - no CORS needed. default_server so this config
# wins even if the nginx package ships its own default site. ---
rm -f /etc/nginx/conf.d/default.conf

cat > /etc/nginx/conf.d/hangman.conf <<'EOF'
server {
    listen 80 default_server;
    server_name _;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
EOF

nginx -t
systemctl enable nginx
systemctl start nginx

echo "cloud-init done: hangman.service and nginx should both be active now."
